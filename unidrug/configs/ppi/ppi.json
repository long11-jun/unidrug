{
    "model": "ppi",
    "_version": "2.1",
    "_architecture": "PPI uses two protein branches. DDI uses two drug branches.",
    "data": {
        "protein": {
            "modality": [
                "structure",
                "kg",
                "text"
            ],
            "featurizer": {
                "structure": {
                    "name": "index",
                    "max_len": 1200
                },
                "kg": {
                    "name": "KGE",
                    "kg_name": "BMKG",
                    "kg_path": "{asset_root}/assets/kg/BMKG/",
                    "save_path": "{asset_root}/assets/kg/BMKG/kge",
                    "kge_file": "embedding.pkl",
                    "embed_dim": 256
                },
                "text": {
                    "name": "RawString",
                    "max_length": 512
                }
            }
        }
    },
    "network": {
        "protein": {
            "structure": {
                "name": "DeepMCNN",
                "vocab_size": 26,
                "embedding_num": 128,
                "hidden_size": 128,
                "output_size": 256,
                "dropout": 0.1
            },
            "kg": {
                "embedding_dim": 256
            }
        },
        "llm": {
            "name": "qwen",
            "model_name": "{asset_root}/qwen2.5-3b-instruct",
            "max_length": 512,
            "device": "cuda:0",
            "torch_dtype": "bfloat16"
        },
        "kg_path": "{asset_root}/assets/kg/BMKG",
        "kg_dim": 256,
        "use_text": true,
        "protein_text_path": null,
        "use_foldseek": false,
        "prot_3d_mode": "property",
        "foldseek": {
            "embedding_dim": 128,
            "hidden_dim": 128,
            "output_dim": 256,
            "max_length": 1500,
            "dropout": 0.1
        },
        "adapter_dropout": 0.25,
        "num_struct_tokens": 40,
        "num_kg_tokens": 28,
        "num_3d_tokens": 32,
        "use_lora": true,
        "lora_rank": 32,
        "lora_alpha": 64,
        "lora_dropout": 0.15,
        "head_dropout": 0.15,
        "use_feature_noise": true,
        "feature_noise_std": 0.02,
        "use_attention_pooling": true,
        "pooling_dropout": 0.12,
        "stability": {
            "logits_clamp_abs": 10.0
        },
        "num_classes": 7,
        "multilabel": true,
        "cmsa": {
            "enabled": true,
            "sub_dim": 128,
            "topk": 16,
            "num_heads": 2,
            "dropout": 0.1,
            "align_lambda": 0.05,
            "retrieve_lambda": 0.1
        },
        "mars": {
            "enabled": true,
            "sub_dim": 64
        },
        "_ablation_options": {
            "no_cmsa": "Disable SA-CMSA knowledge-graph completion",
            "no_cmon": "Disable CMON orthogonal decomposition",
            "no_cmsa,no_cmon": "Disable both SA-CMSA and CMON",
            "no_foldseek": "Disable the 3D protein modality",
            "_usage": "Pass a comma-separated list through the ABLATION variable"
        }
    }
}
